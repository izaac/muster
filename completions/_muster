#compdef muster
# Zsh completion for muster. Install by putting this file (named _muster) in a
# directory on your $fpath, e.g.:
#   mkdir -p ~/.zfunc && cp completions/_muster ~/.zfunc/_muster
#   echo 'fpath=(~/.zfunc $fpath); autoload -U compinit && compinit' >> ~/.zshrc

_muster() {
  local -a commands
  commands=(
    'up:Create/ensure a cluster and install Rancher, then wait + hand off'
    'build-ui:Build a dashboard UI dist from the branch matching --version'
    'wait:Run readiness gates against an existing instance'
    'tunnel:Manage the cloudflared quick tunnel'
    'warmup:Prime the provisioning controller'
    'import:Create a second k3d cluster and import it into the management Rancher'
    'mirror:Copy the images an airgapped install needs into a registry'
    'down:Tear down the cluster and sweep state'
    'env:Print the consumer handoff'
    'show:Print the resolved configuration'
    'version:Print the muster version'
    'help:Show help'
  )

  _arguments -C \
    '--provider[Substrate driver]:provider:(k3d existing docker)' \
    '--instance[Instance id]:instance:' \
    '--external[Expose Rancher via a public tunnel]' \
    '--version[Rancher image tag]:tag:' \
    '--repo[Rancher channel]:channel:(rancher-prime rancher-prime-ga rancher-latest rancher-alpha rancher-community rancher-com-rc rancher-com-alpha)' \
    '--channel-source[Where the channel and image come from]:source:(fixed metadata prime prime-head prime-ga community-ga)' \
    '--password[Rancher bootstrap/admin password]:password:' \
    '--image-tag[Install this server image tag against the resolved chart]:tag:' \
    '--out[Handoff format]:format:(env cypress json)' \
    '--registry[Target/private registry for mirror and airgap]:registry:' \
    '--airgap[Resolve every image through --registry]' \
    '--insecure-registry[Skip TLS verification against the registry]' \
    '--mirror-all[Mirror the whole published image list]' \
    '--mirror-extension[Also mirror the K3K extension images]' \
    '--k3k-version[K3K version to mirror]:tag:' \
    '--k3s-versions[How many newest k3s versions to mirror]:n:' \
    '--from-cluster[For mirror: copy what the running cluster asks for]' \
    '--import-instance[For import: the downstream k3d instance (e2e-<n>)]:instance:' \
    '--management-instance[For down of a downstream: the management instance]:instance:' \
    '--dashboard-src[rancher/dashboard checkout]:dir:_files -/' \
    '--dashboard-dist[prebuilt UI dist]:dir:_files -/' \
    '--dashboard-branch[Force the UI branch]:branch:' \
    '--ui-offline[Which UI Rancher serves]:mode:(true false dynamic auto)' \
    '--node-bin[Node bin dir for build-ui]:dir:_files -/' \
    '--kubeconfig[Kubeconfig for the target cluster]:file:_files' \
    '--rancher-host[Hostname Rancher is served at]:host:' \
    '--config[Config file to source]:file:_files' \
    '--dry-run[Resolve and print the plan; create nothing]' \
    '--prefer-staging[Promote a rolling head tag to a newer staging build]' \
    '(-h --help)'{-h,--help}'[Show help]' \
    '1:command:->command' \
    '*::arg:->args'

  case "$state" in
    command) _describe -t commands 'muster command' commands ;;
  esac
}

_muster "$@"
